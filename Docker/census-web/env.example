# Copy to .env (next to docker-compose.yml) and fill in.
CENSUS_DIR=/path/to/census            # holds census.sqlite and curation.sqlite
PROXY_FACING_ADDR=10.0.0.2            # this host's address on the network the SSO proxy uses
ETHOCENSUS_TRUSTED_PROXIES=10.0.0.1   # the SSO proxy's address (comma-separated; CIDR allowed)
ETHOCENSUS_PUBLIC_HOSTS=metadata.example.org
ETHOCENSUS_USER_HEADER=X-Forwarded-Email
