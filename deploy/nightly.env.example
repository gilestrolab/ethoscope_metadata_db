# Copy to ~/.config/ethocensus/nightly.env and fill in. No secrets here: the Garage key goes
# in an encrypted systemd credential (see README.md).
ETHOCENSUS_REPO=/path/to/ethoscope_metadata_db
ETHOCENSUS=/path/to/ethoscope_metadata_db/.venv/bin/ethocensus
CENSUS_DIR=/path/to/census
CENSUS_CONFIG=/path/to/census/census.toml
BACKUP_DIR=/path/to/census/backups
GARAGE_BUCKET=my-bucket
